# --- Backend ---
PORT=5001
NODE_ENV=development
TRUST_PROXY=1
BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=30000
# Allowed CORS origins. In development, private-IP origins
# (localhost/LAN/VMs) are auto-allowed by the backend, so you only
# need to add explicit origins when running in production.
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_LOG_TO_DB=false

# --- Cloudflare Turnstile ---
TURNSTILE_SECRET_KEY=your-turnstile-secret

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-private-bucket
MAX_UPLOAD_BYTES=15728640
LARGE_UPLOAD_THRESHOLD_BYTES=5242880
MEDIA_UPLOAD_URL_EXPIRES_SECONDS=300
MEDIA_DOWNLOAD_URL_EXPIRES_SECONDS=300

# --- AI ---
OPENROUTER_API_KEY=your-openrouter-api-key
AI_MAX_TOKENS=160
AI_TIMEOUT_MS=30000
AI_DAILY_TOKEN_LIMIT=4000
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_COOLDOWN_MS=60000
REQUEST_SIGNING_MAX_SKEW_MS=300000
MAX_ACCESS_TOKEN_LIFETIME_SEC=900

# -- FCM Service Account ---
FCM_SERVICE_ACCOUNT_PATH=your-path