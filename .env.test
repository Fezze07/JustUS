# --- Backend ---
ENV=test
NODE_ENV=test
PORT=5001
TRUST_PROXY=1
REQUEST_TIMEOUT_MS=15000
BODY_LIMIT=1mb
# In test, private-IP origins (localhost/LAN/VMs) are not auto-allowed:
# list every origin the test client uses here.
ALLOWED_ORIGINS=http://localhost:3000
# REQUIRED (env.js): mobile-app version metadata dir — not touched by tests.
JUSTUS_DATA_DIR=./test-data
# REQUIRED (env.js): log-retention days.
LOG_RETENTION_DAYS=90

# --- Supabase ---
SUPABASE_URL=https://supabase.test.local
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key
SUPABASE_LOG_TO_DB=false
MAX_ACCESS_TOKEN_LIFETIME_SEC=900

# --- FCM Service Account ---
# Placeholder path: it deliberately does not exist. initializeFirebaseAdmin()
# wraps the require() in a try/catch and reports "not configured", so
# sendMulticastNotification stays on its configured:false branch and no real
# service-account file is ever needed (or committed).
FCM_SERVICE_ACCOUNT_PATH=./test-data/fcm-service-account.json

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=test-account
R2_ACCESS_KEY_ID=test-access-key
R2_SECRET_ACCESS_KEY=test-secret-key
R2_ENDPOINT=https://r2.test.local
R2_BUCKET_NAME=justus-test
MEDIA_UPLOAD_URL_EXPIRES_SECONDS=300
MEDIA_DOWNLOAD_URL_EXPIRES_SECONDS=300
MAX_UPLOAD_BYTES=15728640
LARGE_UPLOAD_THRESHOLD_BYTES=5242880

REQUEST_SIGNING_MAX_SKEW_MS=300000