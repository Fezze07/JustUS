{
  "threshold": 10,
  "minLines": 5,
  "minTokens": 35,
  "mode": "weak",
  "reporters": [
    "html",
    "console",
    "json"
  ],
  "ignore": [
    "node_modules/**",
    "**/node_modules/**",
    "jscpd-report/**",
    "**/jscpd-report/**",
    "**/.git/**",
    "**/build/**",
    "**/.dart_tool/**",
    "**/ios/**",
    "**/android/**",
    "**/macos/**",
    "**/windows/**",
    "**/linux/**",
    "**/web/**",
    "**/graphify-out/**",
    "**/.agents/**",
    "**/docs/**",
    "**/lib/core/localization/generated/**",
    "**/generated/**",
    "**/theme/app_palette.dart",
    "**/supabase/schemas/**",
    "**/.pgdelta-export.json",
    "**/*.g.dart",
    "**/*.freezed.dart",
    "**/*.part.dart",
    "**/test/**",
    "**/coverage/**"
  ],
  "output": "./jscpd-report"
}