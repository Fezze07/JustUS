{
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "check": "node --check index.js",
    "test": "npm run lint && jest ../test/backend --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "scan:duplicates": "jscpd ../ --config ../.jscpd.json",
