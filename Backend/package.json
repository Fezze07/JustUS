    "axios": "^1.13.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "jest": "^30.3.0",
    "jscpd": "^4.0.9",
    "madge": "^8.0.0",
    "supertest": "^7.2.2"
  }
