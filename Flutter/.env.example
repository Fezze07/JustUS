# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- API Configuration ---
# Single source of truth for the backend server address:
#   API_DEBUG_BASE_URL   -> debug builds (e.g. your new server VM: http://<vm-ip>:5002)
#   API_RELEASE_BASE_URL -> release builds (public domain)
API_DEBUG_BASE_URL=http://[IP_ADDRESS]
API_RELEASE_BASE_URL=https://example.com
IS_DEBUG=true

# --- Turnstile Configuration ---
TURNSTILE_PUB_SITE_KEY=your-key