# --- Supabase Configuration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- API Configuration ---
# The backend Base URL is selected from the real Flutter build mode in
# lib/core/network/api_config.dart, with a config-default origin per mode:
#   Debug   -> https://justus-dev.serverfede.eu
#   Release -> https://justus.serverfede.eu
# Override at build time with --dart-define, e.g.:
#   flutter run --dart-define=JUSTUS_DEV_SERVER_ORIGIN=https://your-host
#   flutter build apk --dart-define=JUSTUS_PROD_SERVER_ORIGIN=https://your-host

# --- Turnstile Configuration ---
TURNSTILE_PUB_SITE_KEY=your-key